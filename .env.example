# Copy to .env and fill in. Everything has a safe local default except Razorpay keys.

# Local dev defaults to SQLite so the app runs with zero external services.
# For a production-shaped run, point this at Postgres instead:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/recovery
DATABASE_URL=sqlite:///./recovery.db

# Razorpay test-mode credentials (https://dashboard.razorpay.com/app/keys)
# Leave blank to run against the DryRun gateway (no network calls, fake success responses).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signature secret, from the Razorpay dashboard's webhook settings.
# LEAVING THIS UNSET DISABLES SIGNATURE VERIFICATION. That is intentional for local
# runs and CI, which have no secret and must still work offline — but it means an
# exposed deployment without this value will accept a fabricated failed payment from
# anyone, and act on it.
RAZORPAY_WEBHOOK_SECRET=

# --- Compliance / policy knobs (deterministic core, Sprint 1) ---
# RBI AFA exemption ceiling for recurring debits without per-transaction 2FA (paise).
AFA_EXEMPT_CEILING_PAISE=1500000
# RBI-mandated pre-debit notice window before a recurring charge above the notice-exempt
# threshold can be attempted.
PRE_DEBIT_NOTICE_HOURS=24
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_HOURS=24
DAILY_CONTACT_CAP=1
CONTROL_GROUP_RATE=0.15

# Circuit breaker: if an issuer/BIN's decline rate over the rolling window exceeds this,
# pause auto-retries against that issuer.
ISSUER_CIRCUIT_BREAKER_WINDOW_MINUTES=60
ISSUER_CIRCUIT_BREAKER_MIN_SAMPLES=10
ISSUER_CIRCUIT_BREAKER_DECLINE_RATE_THRESHOLD=0.8

# --- LLM layer (Sprint 3) ---
# Leave ANTHROPIC_API_KEY unset to run fully offline: the rule table still classifies
# every clean error code, and free-text narrations route to human review instead of
# being guessed at. Nothing else changes.
ANTHROPIC_API_KEY=

# Self-consistency ensemble. Probes use different FRAMINGS rather than different
# temperatures, because temperature is removed on Claude Opus 5 (see llm_classifier.py).
LLM_SELF_CONSISTENCY_SAMPLES=3
LLM_MIN_AGREEMENT=0.6
LLM_MIN_CONFIDENCE=0.7

# Generated customer-facing copy. Off by default: this is the only stage whose output
# reaches a real person, so it is opted into rather than out of. Templates ship
# regardless, and a generated draft that fails validation is discarded for one.
LLM_COPY_ENABLED=false
